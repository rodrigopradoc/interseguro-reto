{
  "name": "reto",
  "version": "1.0.0",
  "scripts": {
    "dev:go": "cd go-api && go run main.go",
    "dev:node": "cd node-api && npx nodemon src/index.ts",
    "dev:web": "cd web && ng serve",
    "dev": "npm-run-all --parallel dev:go dev:node dev:web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
