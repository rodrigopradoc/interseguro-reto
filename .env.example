# ── Puertos ────────────────────────────────────────────────────────────────────
GO_API_PORT=8080
NODE_API_PORT=3000
WEB_PORT=4200
DB_PORT=5432

# ── URLs internas Docker ────────────────────────────────────────────────────────
NODE_API_URL=http://node-api:3000

# ── JWT ─────────────────────────────────────────────────────────────────────────
# Genera una clave segura: openssl rand -hex 32
JWT_SECRET=your-secret-key-here

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_NAME=interseguro
DB_USER=postgres
DB_PASSWORD=your-password-here

# ── CORS ────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200
